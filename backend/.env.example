# Multi-Agent Orchestrator — EXEMPLE de configuration.
#
# Copier ce fichier vers backend/.env (développement) et remplacer les valeurs.
# Le fichier .env réel n'est JAMAIS committé (SECURITY.md §15).
#
# En production, le fichier équivalent est /etc/multi-agent-orchestrator/production.env,
# créé par deploy/setup.sh, avec des permissions 0600.

# --- Environnement -----------------------------------------------------------
# development | production
ORCHESTRATOR_ENV=development
LOG_LEVEL=INFO
# Documentation interactive : true en développement, false (ou accès admin) en production.
ENABLE_DOCS=true

# --- Persistance -------------------------------------------------------------
# Chemin du fichier SQLite. En production :
# /var/lib/multi-agent-orchestrator/orchestrator.db
DATABASE_PATH=./data/orchestrator.db

# --- Secrets -----------------------------------------------------------------
# Clé de signature des sessions et de chiffrement de la clé d'enregistrement.
# Générer avec : python -c "import secrets;print(secrets.token_urlsafe(64))"
# Valeur fictive ci-dessous : à remplacer impérativement.
SECRET_KEY=J_1W-DKgt84aA4-0PkPVCYJvbr1L-72zcrwgqLJI7lyoCOmKUMkmNbh7QgzNEaconnSmwlmQBYRXR5d6MdIrcQ

# Clé d'enregistrement des agents. Si elle est absente, le backend en génère une
# au premier démarrage et la conserve chiffrée en base (consultable dans le
# tableau de bord → Paramètres).
ENROLLMENT_KEY=

# --- Sessions administrateur -------------------------------------------------
ADMIN_SESSION_TTL_HOURS=12
ADMIN_SESSION_IDLE_MINUTES=120

# --- Présence des agents -----------------------------------------------------
AGENT_OFFLINE_THRESHOLD_SECONDS=90
MONITOR_INTERVAL_SECONDS=15
TASK_DEFAULT_TIMEOUT_SECONDS=3600

# --- Réseau ------------------------------------------------------------------
# Origines autorisées pour le frontend en développement (séparées par des virgules).
ALLOWED_ORIGINS=http://127.0.0.1:5173,http://localhost:5173
# Proxys de confiance : seuls ceux-ci peuvent fournir X-Forwarded-For (SECURITY.md §8).
TRUSTED_PROXIES=127.0.0.1,::1

# --- Limites et protections --------------------------------------------------
MAX_REQUEST_BYTES=1000000
MAX_RESULT_BYTES=262144
LOGIN_RATE_LIMIT=5/minute
ENROLL_RATE_LIMIT=10/hour
AGENT_RATE_LIMIT=300/minute
ADMIN_RATE_LIMIT=600/minute
